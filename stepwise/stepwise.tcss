Screen {
    layout: vertical;
}

/* Labels default to content width, which cuts off long questions instead of wrapping. */
Label {
    width: 1fr;
}

#topbar {
    height: 1;
    padding: 0 1;
    background: $panel;
}

#sidebar {
    width: 34;
    height: 1fr;
    border: none;
    border-right: solid $panel-lighten-2;
    padding: 1 0;
}

#stage {
    height: 1fr;
    padding: 1 3;
}

.stage-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.intro {
    margin-bottom: 1;
}

.hint {
    color: $text-muted;
    margin-bottom: 1;
}

.quote {
    color: $text-muted;
    border-left: thick $accent;
    padding: 0 1;
    margin-bottom: 1;
}

.question {
    text-style: bold;
    margin-top: 1;
}

.section {
    text-style: bold;
    color: $accent;
    margin-top: 2;
}

.tag {
    color: $text-muted;
    text-style: italic;
}

#nav {
    height: auto;
    margin-top: 1;
}

#nav Button {
    margin-right: 1;
}

#preview {
    width: 45%;
    height: 1fr;
    border-left: solid $panel-lighten-2;
    padding: 0 1;
    background: $surface;
}

/* The preview marks the answer being edited as Markdown strong. Bold is barely visible in
   many terminal fonts, so it's shown as a colour and tint instead, like a highlighter. */
#preview-md MarkdownBlock > .strong {
    text-style: none;
    color: $accent;
    background: $accent 15%;
}

/* Textual underlines level-2 headings but not level-3, which looked random. Sections are
   bold and subheadings plain instead, with no underlines anywhere. */
#preview-md MarkdownH2 {
    text-style: bold;
}

#preview-md MarkdownH3 {
    text-style: none;
}

#preview-title {
    color: $text-muted;
    text-style: italic;
    padding: 1 0 0 1;
}

.readme-buttons {
    height: auto;
}

.answer {
    height: auto;
    min-height: 6;
    max-height: 20;
    margin-top: 1;
}

#step-list {
    height: auto;
    max-height: 20;
    border: round $panel-lighten-2;
    padding: 0 1;
}

#step-list:focus {
    border: round $accent;
}

AnswerChoice {
    height: auto;
    max-height: 30;
    margin-top: 1;
    border: round $panel-lighten-2;
    padding: 0 1;
}

AnswerChoice:focus {
    border: round $accent;
}

#step-input {
    margin-top: 1;
}

/* A Vertical is as tall as the visible stage by default, and hides what doesn't fit. Panels grow
   with their content instead, so the stage scrolls to show all of it. */
.readme-panel, .run-panel, .code-panel, .check-panel, .deps-panel {
    height: auto;
}

.readme-panel Button {
    margin: 1 1 1 0;
}

#welcome {
    width: 70;
    height: auto;
    margin: 4 0 0 0;
    padding: 1 3;
    border: round $accent;
}

NameScreen {
    align: center top;
}

#welcome-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.minor {
    color: $text-muted;
    margin-top: 1;
}

.primer {
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
}

.file-pick, .file-bar, .run-buttons {
    height: auto;
    margin-top: 1;
}

.file-pick Select {
    width: 1fr;
    margin-right: 1;
}

.file-bar Static {
    padding: 1 0 0 1;
    color: $text-muted;
}

#file-view, .deps-view {
    height: auto;
    min-height: 5;
    max-height: 18;
    margin-top: 1;
}

#done {
    margin-top: 1;
}

.command {
    background: $panel;
    padding: 0 1;
    margin-top: 1;
}

.run-buttons Button {
    margin-right: 1;
}

#output {
    height: 14;
    margin-top: 1;
    border: round $panel-lighten-2;
}

.trial #output {
    height: 8;
}

/* The line the app is still printing, like a prompt waiting for an answer, and the box to answer in. */
#partial {
    padding: 0 1;
}

#send {
    margin-top: 1;
}

#run-status {
    margin-top: 1;
}

#branch {
    height: auto;
}

/* Panels that need something the user hasn't made yet (steps, files, a command) are greyed,
   with a plain line above saying what they're waiting for. */
.panel-body {
    height: auto;
}

.waiting {
    opacity: 45%;
}

.waiting-note {
    color: $text-muted;
    margin: 1 0;
}

.sample {
    border: round $panel-lighten-2;
    padding: 1 2;
    height: auto;
}

.congrats-panel {
    height: auto;
}

.congrats-title {
    text-style: bold;
    color: $accent;
    margin: 1 0;
}

.congrats-stats {
    margin: 1 0;
}

.congrats-panel Button {
    margin-top: 1;
}
